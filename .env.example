# Kontaktskjema – e-post via Resend (https://resend.com)
# Kreves for at skjemaet skal sende. Sett i .env.local (lokalt) og i Vercel (produksjon).

# API-nøkkel fra Resend-kontoen din
RESEND_API_KEY=

# Hvem henvendelsene sendes til (default: post@byggsolberg.no)
CONTACT_TO=post@byggsolberg.no

# Avsender. Må være på et domene du har verifisert i Resend.
# Til testing kan du bruke: Solberg Byggservice <onboarding@resend.dev>
CONTACT_FROM=Solberg Byggservice <post@byggsolberg.no>
